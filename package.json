{
  "name": "phills-agent",
  "displayName": "Phills",
  "version": "1.4.1",
  "description": "Phills - Your stealth AI browser agent",
  "author": "Phills Dev",
  "scripts": {
    "dev": "plasmo dev --no-cs-reload",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "name": "Phills",
    "host_permissions": ["<all_urls>"],
    "permissions": [
      "tabs",
      "activeTab",
      "history",
      "storage",
      "debugger",
      "scripting",
      "sidePanel",
      "alarms",
      "clipboardRead",
      "clipboardWrite",
      "downloads",
      "sessions",
      "topSites",
      "management",
      "cookies",
      "browsingData",
      "bookmarks"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
}
